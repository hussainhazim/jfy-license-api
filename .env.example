# ─────────────────────────────────────────────
# JFY License API — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# On the VPS: pass these via docker run --env-file
# or a docker-compose env_file directive.
# ─────────────────────────────────────────────

# ── Supabase ─────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin credentials ─────────────────────────
# Used to authenticate the Admin Panel.
# Use a strong, randomly generated password.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-strong-random-password

# ── JWT ──────────────────────────────────────
# Must be a cryptographically random secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be the same across all container instances
# if you ever scale horizontally.
JWT_SECRET=change-me-64-char-random-hex-string

# ── Server ───────────────────────────────────
PORT=3000

# ── CORS ─────────────────────────────────────
# Comma-separated list of origins the Admin Panel
# is served from. No trailing slash.
# Example (multiple origins):
#   CORS_ORIGINS=https://admin.jfy.com,https://www.admin.jfy.com
# Leave unset to fall back to localhost (dev only).
CORS_ORIGINS=https://your-admin-panel-domain.com
